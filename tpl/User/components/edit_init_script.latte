function cleanName() {
{syntax off}
    var result = [];
    for (var i = 0; i < arguments.length; i++) {
        var name = arguments[i];
        if (name == null) {
            result.push('');
            continue;
        }
        name = String(name)
            .replace(/<[^>]*>/g, ' ')
            .replace(/\u00A0/g, ' ')
            .replace(/[\u2018\u2019\u02BC\u0060]/g, "'")
            .replace(/[\u2010-\u2015\u2212]/g, '-')
            .replace(
                /[^A-Za-z\u00C0-\u024F\u0300-\u036F\u0370-\u052F\u0530-\u058F\u0590-\u06FF\u10A0-\u10FF '\-]/g,
                '')
            .replace(/\s+/g, ' ')
            .replace(/-{2,}/g, '-')
            .replace(/'{2,}/g, "'")
            .replace(/\s*-\s*/g, '-')
            .replace(/\s*'\s*/g, "'")
            .replace(/^[\s'\-]+|[\s'\-]+$/g, '')
            .toLowerCase();
        var normalized = '';
        var upperNext = true;
        for (var j = 0; j < name.length; j++) {
            var character = name.charAt(j);

            if (
                character == ' ' ||
                character == '-' ||
                character == "'") {
                normalized += character;
                upperNext = true;
            } else {
                normalized += upperNext
                 ? character.toUpperCase()
                 : character;

                upperNext = false;
            }
        }
        result.push(normalized);
    }
    return result;
{/syntax}
}

