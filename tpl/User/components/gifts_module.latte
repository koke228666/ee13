{var $canSeeGifts   = \OPENVK_ROOT_CONF['openvk']['preferences']['commerce']}
{var $gift_count   = $user->getGiftCount() > 0}
{var $thatIsThisUser = isset($thisUser) && $user->getId() == $thisUser->getId()}
{var $completeness = $user->getProfileCompletenessReport()}

<div id="gifts_count_module" class="counts_module" n:if="$canSeeGifts && ($gift_count < 1) && !$thatIsThisUser">
  <div>
    <a class="gifts clear_fix" onclick="return Profile.giftTooltip(this, event);" onmouseover="Profile.prepareGiftTooltip(event);" href="/gifts?act=pick&user={$user->getId()}">
        <span class="fl_r thumb"></span>
        <div class="profile_gifts_send fl_l">{_send_gift}</div>
    </a>
  </div>
  {if !$thisUser->prefersNotToSeeRating()}
    <div class="rate_line">
        <div class="rate_text">{$completeness->total}%</div>
        <div class="rate_left fl_l" style="width: {if $completeness->total >= 100}100{else}{$completeness->total}{/if}%;"></div>
        <div class="rate_right fl_r" style="width: {if $completeness->total >= 100}0{else}{100 - $completeness->total}{/if}%;"></div>
    </div>
   {else}
    <div class="rate_empty_line"></div>
   {/if}
</div>

<div class="module clear gifts_list_module" id="profile_gifts" n:if="$canSeeGifts && ($gift_count > 0)">
    <a href="/gifts{$user->getId()}" class="module_header">
        <div class="header_top clear_fix">
            <span class="right_link fl_r" onmouseover="this.parentNode.parentNode.href='/gifts?act=pick&user={$user->getId()}'" onmouseout="this.parentNode.parentNode.href='/gifts?act=pick&user={$user->getId()}'"></span>
            <div id="gifts_module_header" class="fl_l">{if !$thatIsThisUser}{_send_gift}{else}{_gifts}{/if}</div>
        </div>
    </a>
    <div class="module_body clear_fix">
        <a href="/gifts{$user->getId()}" style="text-decoration: none !important;">
        <img n:foreach="$user->getGifts(1, 4) as $giftDescriptor" class="giftImg" src="{$giftDescriptor->gift->getImage(2)}" align="">
        </a>
    </div>
</div>